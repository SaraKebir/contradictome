# ==============================================================================
# Contradictome Environment Configuration Example
# Copy this file to .env and configure your desired API keys.
# (Contradictome also functions 100% offline out-of-the-box without any keys!)
# ==============================================================================

# xAI / Grok API Key (Recommended)
XAI_API_KEY=xai-your-grok-api-key-here
# or GROK_API_KEY=xai-your-grok-api-key-here

# OpenAI API Key (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here

# Default Model Selection
# Options: grok-2-latest, grok-beta, gpt-4o-mini, gpt-4o, claude-3-5-sonnet
DEFAULT_MODEL=grok-2-latest

# Server Settings
CONTRADICTOME_PORT=5050
CONTRADICTOME_HOST=127.0.0.1
DEBUG=true
